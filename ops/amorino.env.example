# Install as /etc/amorino.env, owned root:amorino, mode 0640. Replace all PENDING values.
AMORINO_SECRET_KEY=PENDING_GENERATE_WITH_SECRETS_TOKEN_HEX_32
AMORINO_SUPERVISOR_PIN=PENDING_UNIQUE_STRONG_CREDENTIAL
AMORINO_DB_PATH=/var/lib/amorino/amorino.db
AMORINO_HTTPS=1
AMORINO_TRUST_PROXY=1
AMORINO_HOST=127.0.0.1
AMORINO_PORT=8000
AMORINO_THREADS=8
AMORINO_PROCESSES=1
AMORINO_STORAGE=local
AMORINO_DEBUG=0
AMORINO_DEMO=0
AMORINO_SEED=0
TZ=Europe/Lisbon
# Optional off-server copy: fill only after approving destination/access/retention.
# AMORINO_OFFSERVER_DEST=backupuser@PENDING_BACKUP_HOST:/srv/amorino/backups/
# AMORINO_OFFSERVER_HOST=backupuser@PENDING_BACKUP_HOST
